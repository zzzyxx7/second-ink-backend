HOST=127.0.0.1
PORT=3080
DATA_DIR=./storage
# Empty = SQLite for local development. MySQL uses a dedicated database:
# DATABASE_URL=mysql://secondink:secondink_dev@127.0.0.1:3307/second_ink
DATABASE_URL=
# Embedded worker for local development; set false when starting npm run worker separately.
EMBEDDED_WORKER=true
# Exact frontend origin, e.g. http://localhost:5173. Empty = same origin only.
FRONTEND_ORIGIN=
SESSION_HOURS=24
# Optional single-Agent HTTP adapter. Leave blank to keep RULES-only operation.
# Base URL must stop before /chat/completions, e.g. https://your-provider.example/v1
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=30000

{
  "name": "second-ink-backend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:worker": "npm run build && node scripts/smoke.mjs --separate-worker",
    "smoke:team": "npm run build && node scripts/smoke.mjs --team",
    "smoke:team:worker": "npm run build && node scripts/smoke.mjs --team --separate-worker",
    "openapi": "npm run build && node scripts/export-openapi.mjs",
    "smoke:branch": "npm run build && node scripts/smoke.mjs --branch",
    "smoke:branch:worker": "npm run build && node scripts/smoke.mjs --branch --separate-worker"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/yauzl": "^2.10.3",
    "jszip": "^3.10.1",
    "typescript": "^5.9.0"
  }
}
